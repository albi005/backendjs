<%- include('header', { title: owner.name }) -%>
<%- include('menu', { active: 'owners' }) -%>

    <main class="detail">
        <form method="POST" action="/owners/<%= owner._id %>">
            <div class="entity">
                <div class="fields">
                    <div class="field">
                        <span class="label">Név:</span>
                        <input class="editable" type="text" name="name" value="<%= owner.name %>" aria-label="Név">
                    </div>

                    <div class="field">
                        <span class="label">Cím:</span>
                        <input class="editable" type="text" name="address" value="<%= owner.address %>" aria-label="Cím">
                    </div>

                    <div class="field">
                        <span class="label">Elérhetőség:</span>
                        <input class="editable" type="text" name="contact" value="<%= owner.contact %>" aria-label="Elérhetőség">
                    </div>
                </div>

                <div class="actions">
                    <button class="icon-btn save" type="submit" title="Mentés" aria-label="Mentés">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v6h8V3"/><rect x="8" y="13" width="8" height="5"/></svg>
                    </button>
                    <a class="icon-btn delete" href="/owners/<%= owner._id %>/del" title="Törlés" aria-label="Törlés">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/></svg>
                    </a>
                </div>
            </div>
        </form>

        <a class="add" href="/animals/new">+ Hozzáadás</a>

        <table class="list">
            <tbody>
                <% animals.forEach(function (animal) { %>
                    <tr>
                        <td><a class="row-link" href="/animals/<%= animal._id %>"><%= animal.name %></a></td>
                        <td><%= animal.species %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>

<%- include('footer') -%>
