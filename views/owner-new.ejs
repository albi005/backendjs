<%- include('header', { title: 'Új tulajdonos' }) -%>
<%- include('menu', { active: 'owners' }) -%>

    <main class="detail">
        <form method="POST" action="/owners/new">
            <div class="entity">
                <div class="fields">
                    <div class="field">
                        <span class="label">Név:</span>
                        <input class="editable" type="text" name="name" value="" placeholder="Szabó Anna" aria-label="Név">
                    </div>

                    <div class="field">
                        <span class="label">Cím:</span>
                        <input class="editable" type="text" name="address" value="" placeholder="Budapest, Fő utca 1." aria-label="Cím">
                    </div>

                    <div class="field">
                        <span class="label">Elérhetőség:</span>
                        <input class="editable" type="text" name="contact" value="" placeholder="+36 30 000 0000" aria-label="Elérhetőség">
                    </div>
                </div>

                <div class="actions">
                    <button class="icon-btn save" type="submit" title="Mentés" aria-label="Mentés">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v6h8V3"/><rect x="8" y="13" width="8" height="5"/></svg>
                    </button>
                </div>
            </div>
        </form>
    </main>

<%- include('footer') -%>
