<%- include('header', { title: animal.name }) -%>
<%- include('menu', { active: 'animals' }) -%>

    <main class="detail">
        <form method="POST" action="/animals/<%= animal._id %>">
            <div class="entity">
                <div class="fields">
                    <div class="field">
                        <span class="label">Név:</span>
                        <input class="editable" type="text" name="name" value="<%= animal.name %>" aria-label="Név">
                    </div>

                    <div class="field">
                        <span class="label">Faj:</span>
                        <input class="editable" type="text" name="species" value="<%= animal.species %>" aria-label="Faj">
                    </div>

                    <div class="field">
                        <span class="label">Tulajdonos:</span>
                        <a class="row-link value" href="/owners/<%= animal._ownerId %>"><%= animal.ownerName %></a>
                    </div>

                    <div class="field">
                        <span class="label">Cím:</span>
                        <span class="value"><%= animal.ownerAddress %></span>
                    </div>
                </div>

                <div class="actions">
                    <button class="icon-btn save" type="submit" title="Mentés" aria-label="Mentés">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v6h8V3"/><rect x="8" y="13" width="8" height="5"/></svg>
                    </button>
                    <a class="icon-btn delete" href="/animals/<%= animal._id %>/del" title="Törlés" aria-label="Törlés">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/></svg>
                    </a>
                </div>
            </div>
        </form>

        <a class="add" href="/animals/<%= animal._id %>/treatments/new">+ Hozzáadás</a>

        <table class="list">
            <tbody>
                <% treatments.forEach(function (treatment) { %>
                    <tr class="treatment">
                        <td class="treatment-status">
                            <label class="vaccinated">
                                <input class="vaccinated" type="checkbox" name="vaccinated" form="treatment-<%= treatment._id %>"<%= treatment.vaccinated ? ' checked' : '' %> aria-label="Oltva">
                                <svg class="icon syringe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><g transform="rotate(45 12 12)"><rect x="8" y="4" width="8" height="9" rx="1"/><line x1="12" y1="13" x2="12" y2="21"/><line x1="8.5" y1="7" x2="15.5" y2="7"/></g></svg>
                            </label><%= treatment.days %> napja
                        </td>
                        <td>
                            <input class="editable" type="text" name="description" form="treatment-<%= treatment._id %>" value="<%= treatment.description %>" aria-label="Kezelés leírása">
                        </td>
                        <td>
                            <form id="treatment-<%= treatment._id %>" method="POST" action="/animals/<%= animal._id %>/treatments/<%= treatment._id %>"></form>
                            <button class="icon-btn save" type="submit" form="treatment-<%= treatment._id %>" title="Mentés" aria-label="Mentés">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v6h8V3"/><rect x="8" y="13" width="8" height="5"/></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>

<%- include('footer') -%>
